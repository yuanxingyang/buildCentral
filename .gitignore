# Build outputs (regenerated by `mk`/build_central.py; never commit).
# Includes build dirs, stage tree, logs, and generated diagrams/JSON.
output/

# Python bytecode / caches.
__pycache__/
*.pyc

# Nested source trees under workspace/ are independently versioned
# (workspace/fdbus is a nested git repo; workspace/protobuf is a symlink to
# one). The framework only references them via the Path field in
# project/build/build_central.cfg. Only workspace/Readme.txt is tracked.
# No trailing slash: matches both real dirs and the symlink.
workspace/fdbus
workspace/protobuf

# Claude Code local runtime: per-session locks, scratch state. The committed
# .claude/skills/ tree (buildcentral-build, etc.) IS tracked; only the
# runtime lock file and other transient state here are ignored.
.claude/scheduled_tasks.lock
.claude/plans/
.claude/worktrees/
.claude/projects/
